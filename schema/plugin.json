{
  "jupyter.lab.setting-icon": "ui-components:text-editor",
  "jupyter.lab.setting-icon-label": "PyVista VTK Viewer",
  "title": "PyVista VTK Viewer",
  "description": "Settings for PyVista VTK file viewer",
  "type": "object",
  "properties": {
    "showEdges": {
      "type": "boolean",
      "default": true,
      "description": "Show mesh edges in the visualization"
    },
    "opacity": {
      "type": "number",
      "default": 0.8,
      "minimum": 0,
      "maximum": 1,
      "description": "Mesh opacity"
    },
    "color": {
      "type": "string",
      "default": "lightblue",
      "description": "Default mesh color"
    }
  }
}